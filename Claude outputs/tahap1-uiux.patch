diff --git a/app/Support/ErrorCode.php b/app/Support/ErrorCode.php
new file mode 100644
index 0000000..e8d323a
--- /dev/null
+++ b/app/Support/ErrorCode.php
@@ -0,0 +1,87 @@
+<?php
+
+namespace App\Support;
+
+use Illuminate\Http\Request;
+use Illuminate\Support\Str;
+
+/**
+ * Kode error yang ditampilkan ke pengguna (Spesifikasi UI/UX 6.6):
+ * "Terjadi kesalahan sistem. Silakan hubungi admin (kode: SJ-500-7KQ2)."
+ *
+ * Format: {MODUL}-{STATUS}-{REF}. REF sama dengan `error_ref` di log,
+ * jadi admin bisa mencari detail error di storage/logs berdasarkan kode itu.
+ */
+class ErrorCode
+{
+    protected static ?string $ref = null;
+
+    /** Segmen URL /admin/{segmen} → singkatan modul. */
+    public const MODULES = [
+        'quotations' => 'QO',
+        'sale-orders' => 'SO',
+        'delivery-orders' => 'DO',
+        'surat-jalans' => 'SJ',
+        'sales-invoices' => 'INV',
+        'invoices' => 'INV',
+        'customer-receipts' => 'BYR',
+        'customer-returns' => 'RTJ',
+        'return-products' => 'RDO',
+        'warehouse-confirmations' => 'GDG',
+        'purchase-receipts' => 'TB',
+        'quality-control-purchases' => 'QC',
+        'inventory-stocks' => 'STK',
+        'stock-transfers' => 'PS',
+        'stock-opnames' => 'SOP',
+        'stock-adjustments' => 'ADJ',
+        'order-requests' => 'PR',
+        'purchase-orders' => 'PO',
+        'purchase-invoices' => 'PINV',
+        'vendor-payments' => 'BS',
+        'purchase-returns' => 'RTB',
+        'cash-bank-transactions' => 'KAS',
+        'deposits' => 'KAS',
+        'account-receivables' => 'AR',
+        'account-payables' => 'AP',
+        'payment-requests' => 'DANA',
+        'journal-entries' => 'JRN',
+        'products' => 'PRD',
+        'customers' => 'CUS',
+        'suppliers' => 'SUP',
+        'users' => 'USR',
+    ];
+
+    /** Referensi unik per request (dipakai di log dan di layar). */
+    public static function ref(): string
+    {
+        return static::$ref ??= strtoupper(Str::random(4));
+    }
+
+    public static function module(?Request $request = null): string
+    {
+        $request ??= request();
+
+        $path = (string) $request->path();
+
+        // Request Livewire (/livewire/update) → ambil halaman asal dari Referer.
+        if (str_starts_with($path, 'livewire') && ($referer = $request->headers->get('referer'))) {
+            $path = ltrim((string) parse_url($referer, PHP_URL_PATH), '/');
+        }
+
+        $segments = explode('/', $path);
+        $segment = ($segments[0] ?? '') === 'admin' ? ($segments[1] ?? '') : ($segments[0] ?? '');
+
+        return static::MODULES[$segment] ?? 'SYS';
+    }
+
+    public static function make(int $status = 500, ?Request $request = null): string
+    {
+        return static::module($request) . '-' . $status . '-' . static::ref();
+    }
+
+    /** Untuk test. */
+    public static function reset(): void
+    {
+        static::$ref = null;
+    }
+}
diff --git a/app/Support/MenuAccess.php b/app/Support/MenuAccess.php
new file mode 100644
index 0000000..2a6a446
--- /dev/null
+++ b/app/Support/MenuAccess.php
@@ -0,0 +1,134 @@
+<?php
+
+namespace App\Support;
+
+use App\Models\AppSetting;
+use Illuminate\Support\Facades\Auth;
+use Illuminate\Support\Facades\Schema;
+use Throwable;
+
+/**
+ * Pembatasan menu & halaman per peran (Spesifikasi UI/UX Bagian 5) dan
+ * pengaturan Modul Aktif. Sumber data: config/menu_access.php.
+ */
+class MenuAccess
+{
+    /** Cache kode peran per objek user (WeakMap: aman untuk test & antar-request). */
+    protected static ?\WeakMap $codeCache = null;
+
+    /** @var array<string, bool>|null */
+    protected static ?array $moduleCache = null;
+
+    /**
+     * Apakah user yang login boleh melihat menu / membuka halaman class ini.
+     */
+    public static function allows(string $class): bool
+    {
+        $allowed = config("menu_access.menus.{$class}");
+
+        // Class tidak terdaftar → tidak dibatasi oleh peta ini.
+        if ($allowed === null) {
+            return true;
+        }
+
+        $user = Auth::user();
+
+        // Belum login: biarkan middleware Authenticate yang menangani.
+        if (! $user) {
+            return true;
+        }
+
+        $codes = static::codesFor($user);
+
+        // User tanpa peran yang dikenal peta ini (mis. peran baru buatan admin lewat menu
+        // Pengguna & Hak Akses, atau user dengan permission langsung) tidak dibatasi di sini;
+        // aksesnya tetap diatur permission/Policy. Tambahkan perannya ke role_groups untuk membatasi.
+        if ($codes === []) {
+            return true;
+        }
+
+        if (array_intersect($codes, (array) config('menu_access.super_codes', ['OWN']))) {
+            return true;
+        }
+
+        return (bool) array_intersect($codes, (array) $allowed);
+    }
+
+    /**
+     * Kode peran (OWN, SM, SLS, ...) milik user.
+     *
+     * @return array<int, string>
+     */
+    public static function codesFor($user): array
+    {
+        static::$codeCache ??= new \WeakMap();
+
+        if (isset(static::$codeCache[$user])) {
+            return static::$codeCache[$user];
+        }
+
+        $roleNames = method_exists($user, 'getRoleNames')
+            ? $user->getRoleNames()->all()
+            : [];
+
+        $codes = [];
+        foreach ((array) config('menu_access.role_groups', []) as $code => $roles) {
+            if (array_intersect($roleNames, (array) $roles)) {
+                $codes[] = $code;
+            }
+        }
+
+        return static::$codeCache[$user] = $codes;
+    }
+
+    /**
+     * Nama modul (manufacturing, delivery_schedule, other_sales) untuk class ini, atau null.
+     */
+    public static function moduleFor(string $class): ?string
+    {
+        foreach ((array) config('menu_access.modules', []) as $module => $definition) {
+            if (in_array($class, (array) ($definition['menus'] ?? []), true)) {
+                return $module;
+            }
+        }
+
+        return null;
+    }
+
+    public static function moduleEnabled(string $module): bool
+    {
+        if (static::$moduleCache === null) {
+            static::$moduleCache = [];
+        }
+
+        if (array_key_exists($module, static::$moduleCache)) {
+            return static::$moduleCache[$module];
+        }
+
+        $default = (bool) config("menu_access.modules.{$module}.default", false);
+
+        try {
+            $value = Schema::hasTable('app_settings')
+                ? AppSetting::get("modules.{$module}", $default)
+                : $default;
+        } catch (Throwable) {
+            $value = $default;
+        }
+
+        return static::$moduleCache[$module] = filter_var($value, FILTER_VALIDATE_BOOLEAN);
+    }
+
+    public static function setModule(string $module, bool $enabled): void
+    {
+        $label = config("menu_access.modules.{$module}.label", $module);
+        AppSetting::set("modules.{$module}", $enabled ? '1' : '0', "Modul Aktif: {$label}");
+        static::$moduleCache = null;
+    }
+
+    /** Dipakai di test / setelah role user berubah. */
+    public static function flush(): void
+    {
+        static::$codeCache = null;
+        static::$moduleCache = null;
+    }
+}
diff --git a/bootstrap/app.php b/bootstrap/app.php
index 7a653e7..2f0d365 100644
--- a/bootstrap/app.php
+++ b/bootstrap/app.php
@@ -42,4 +42,38 @@
 
             return back()->withErrors(['date' => $e->getMessage()])->with('error', $e->getMessage());
         });
+
+        // Spesifikasi UI/UX 6.6: error server tampil sebagai pesan umum + kode, detail hanya di log.
+        // Kode (mis. SJ-500-7KQ2) memuat `error_ref` yang sama dengan entri log.
+        $exceptions->context(fn () => ['error_ref' => \App\Support\ErrorCode::ref()]);
+
+        $exceptions->render(function (\Throwable $e, \Illuminate\Http\Request $request) {
+            if (config('app.debug')) {
+                return null; // mode pengembangan: biarkan halaman error Laravel tampil
+            }
+
+            if ($e instanceof \Illuminate\Validation\ValidationException
+                || $e instanceof \Illuminate\Auth\AuthenticationException) {
+                return null;
+            }
+
+            $status = $e instanceof \Symfony\Component\HttpKernel\Exception\HttpExceptionInterface
+                ? $e->getStatusCode()
+                : 500;
+
+            if ($status < 500) {
+                return null; // 403/404/419 memakai view resources/views/errors/{status}.blade.php
+            }
+
+            $code = \App\Support\ErrorCode::make($status, $request);
+            $message = "Terjadi kesalahan sistem. Silakan hubungi admin (kode: {$code}).";
+
+            if ($request->expectsJson() && ! $request->header('X-Livewire')) {
+                return response()->json(['message' => $message, 'error_code' => $code], $status);
+            }
+
+            return response()
+                ->view('errors.500', ['errorCode' => $code, 'status' => $status], $status)
+                ->header('X-Error-Code', $code);
+        });
     })->create();

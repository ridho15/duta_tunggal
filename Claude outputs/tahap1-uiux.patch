+<?php
+
+/**
+ * Tahap 1 Spesifikasi UI/UX v1.1 (4.1) — tanpa halaman Hub, route lama dialihkan (301),
+ * urutan grup tetap, dan label menu Bahasa Indonesia.
+ */
+
+use App\Models\Cabang;
+use App\Models\User;
+use App\Support\MenuAccess;
+
+it('route Hub lama dialihkan permanen ke halaman tujuan', function (string $old, string $new) {
+    $user = User::factory()->create(['cabang_id' => Cabang::query()->value('id')]);
+    $user->assignRole('Owner');
+
+    $this->actingAs($user)->get($old)->assertStatus(301)->assertRedirect($new);
+})->with([
+    ['/admin/sales-hub', '/admin/sale-orders'],
+    ['/admin/purchase-hub', '/admin/purchase-orders'],
+    ['/admin/delivery-hub', '/admin/delivery-orders'],
+    ['/admin/inventory-hub', '/admin/inventory-stocks'],
+    ['/admin/master-data-hub', '/admin/products'],
+    ['/admin/finance-reports', '/admin/financial-statement'],
+    ['/admin/dashboard-hub', '/admin'],
+]);
+
+it('sidebar Owner memakai urutan grup spesifikasi dan tidak memuat Hub', function () {
+    $user = User::factory()->create(['cabang_id' => Cabang::query()->value('id')]);
+    $user->assignRole('Owner');
+    MenuAccess::flush();
+
+    $html = $this->actingAs($user)->get('/admin')->assertOk()->getContent();
+
+    preg_match_all('/<span[^>]*class="[^"]*fi-sidebar-group-label[^"]*"[^>]*>\s*(.*?)\s*<\/span>/s', $html, $groups);
+    $groups = array_map(fn ($g) => trim(strip_tags($g)), $groups[1]);
+
+    expect($groups)->toBe(['PENJUALAN', 'GUDANG', 'PEMBELIAN', 'KEUANGAN', 'LAPORAN', 'DATA MASTER', 'PENGATURAN'])
+        ->and($html)->not->toContain('sales-hub')
+        ->and($html)->not->toContain('master-data-hub')
+        ->and($html)->toContain('Tugas Saya');
+});
+
+it('label tombol & kolom berbahasa Inggris diterjemahkan lewat lang/id.json', function () {
+    app()->setLocale('id');
+
+    expect(__('Approve'))->toBe('Setujui')
+        ->and(__('Reject'))->toBe('Tolak')
+        ->and(__('Created at'))->toBe('Dibuat pada')
+        ->and(__('So number'))->toBe('No. SO')
+        ->and(\Filament\Tables\Columns\TextColumn::make('created_at')->getLabel())->toBe('Dibuat pada')
+        ->and(\Filament\Tables\Actions\Action::make('approve')->getLabel())->toBe('Setujui')
+        ->and(\Filament\Forms\Components\TextInput::make('so_number')->getLabel())->toBe('No. SO');
+});
diff --git a/tests/Feature/Tahap1/PesanErrorTest.php b/tests/Feature/Tahap1/PesanErrorTest.php
new file mode 100644
index 0000000..29df459
--- /dev/null
+++ b/tests/Feature/Tahap1/PesanErrorTest.php
@@ -0,0 +1,56 @@
+<?php
+
+/**
+ * Tahap 1 Spesifikasi UI/UX v1.1 (6.6) — tidak ada stack trace; error server tampil
+ * sebagai pesan umum Bahasa Indonesia + kode yang juga tercatat di log.
+ */
+
+use App\Support\ErrorCode;
+use Illuminate\Support\Facades\Route;
+
+beforeEach(function () {
+    config(['app.debug' => false]);
+    ErrorCode::reset();
+
+    // Meniru request Livewire dari halaman Surat Jalan (modul dibaca dari Referer).
+    Route::middleware('web')->get('/livewire-uji-error', function () {
+        throw new RuntimeException("SQLSTATE[42S22]: Unknown column 'order_number'");
+    });
+});
+
+it('menampilkan pesan umum + kode, bukan pesan teknis', function () {
+    $response = $this->get('/livewire-uji-error', ['Referer' => url('/admin/surat-jalans/5/edit')]);
+
+    $response->assertStatus(500)
+        ->assertSee('Terjadi kesalahan sistem')
+        ->assertSee('SJ-500-' . ErrorCode::ref())
+        ->assertDontSee('SQLSTATE')
+        ->assertDontSee('order_number')
+        ->assertHeader('X-Error-Code', 'SJ-500-' . ErrorCode::ref());
+});
+
+it('mengembalikan JSON berbahasa Indonesia untuk request API', function () {
+    $this->getJson('/livewire-uji-error', ['Referer' => url('/admin/surat-jalans/create')])
+        ->assertStatus(500)
+        ->assertJsonPath('error_code', 'SJ-500-' . ErrorCode::ref())
+        ->assertJsonMissingPath('exception');
+});
+
+it('halaman 403 dan 404 berbahasa Indonesia', function () {
+    Route::middleware('web')->get('/uji-403', fn () => abort(403));
+
+    $this->get('/uji-403')->assertStatus(403)->assertSee('Anda tidak punya akses ke halaman ini');
+    $this->get('/halaman-yang-tidak-ada')->assertStatus(404)->assertSee('Halaman atau data tidak ditemukan');
+});
+
+it('mode debug tetap menampilkan detail untuk developer', function () {
+    config(['app.debug' => true]);
+
+    $this->get('/livewire-uji-error')->assertStatus(500)->assertSee('order_number');
+});
+
+it('kode modul diambil dari URL halaman', function () {
+    expect(ErrorCode::module(Illuminate\Http\Request::create('/admin/delivery-orders/12/edit')))->toBe('DO')
+        ->and(ErrorCode::module(Illuminate\Http\Request::create('/admin/stock-transfers/create')))->toBe('PS')
+        ->and(ErrorCode::module(Illuminate\Http\Request::create('/admin/tidak-dikenal')))->toBe('SYS');
+});

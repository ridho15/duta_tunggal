APP_NAME="Duta Tunggal ERP"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com

LOG_CHANNEL=stack
LOG_LEVEL=error

# Copy the remaining database, cache, queue, mail, and filesystem settings
# from the deployment secret store. Never commit production credentials.

# Profiler request (default mati). Aktifkan sementara di UAT untuk mengukur aksi lambat:
#   PERF_PROFILE=true  lalu  php artisan perf:report --since=1d   (lihat docs/production-deployment.md)
PERF_PROFILE=false
# PERF_MIN_MS=300
# PERF_MIN_QUERIES=40
